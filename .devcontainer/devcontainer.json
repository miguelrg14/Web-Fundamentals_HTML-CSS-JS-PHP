// GitHub Codespaces / Dev Containers: opens the repository in the cloud with PHP, MariaDB and Node
// ready, and starts the furniture shop on port 8080.
{
  "name": "Web Fundamentals",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  // Install MariaDB and the tools once; start the shop every time the codespace starts.
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-shop.sh",

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Furniture shop", "onAutoForward": "openBrowser" }
  },

  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client", "html-validate.vscode-html-validate"]
    }
  }
}
